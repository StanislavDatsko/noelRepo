# Telegram — both are required to enable Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Forms direct formResponse adapter (optional)
GOOGLE_FORM_ACTION_URL=
GOOGLE_FORM_NAME_ENTRY=
GOOGLE_FORM_PHONE_ENTRY=
# Optional Google Apps Script Web App receiver. It is used instead of direct Forms when set.
GOOGLE_APPS_SCRIPT_URL=
